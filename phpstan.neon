includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 5

    ignoreErrors:
        - '#Unsafe usage of new static#'

    excludePaths:
        - app/Console/Kernel.php
        - app/Exceptions/Handler.php

    checkMissingIterableValueType: false
